# Public site URL used for canonicals, sitemap, and feed links.
# NEXT_PUBLIC_SITE_URL=https://www.centralavemotors.com

# Set to true only at launch. Anything else noindexes the site (feeds stay allowed).
# ROBOTS_INDEX=false

# Inventory. "seed" reads data/inventory.seed.json. "autofunds" is not implemented.
# INVENTORY_SOURCE=seed
# AUTOFUNDS_FEED_URL=

# Lead email via Resend. If either is missing, ADF XML is logged and the form still succeeds.
# RESEND_API_KEY=
# LEAD_FROM_EMAIL=leads@centralavemotors.com
# Backup copy. The primary inbox defaults to the DealerSocket address in lib/leads/destination.ts.
# LEAD_BACKUP_EMAIL=
# LEAD_TO_EMAIL=

# Tracking. Each script loads only after the visitor accepts cookies, and only if the ID is set.
# If GTM is set, the standalone GA4 tag is not loaded.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=

# Server-side Meta Conversions API. Runs only when both a pixel ID and a token are set.
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

# Store code used in the Google Vehicle Ads feed and the Meta dealer id.
# GOOGLE_STORE_CODE=CAM-YONKERS
